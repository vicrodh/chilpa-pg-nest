#!/usr/bin/env python3
"""Preview the Nest surface with synthetic metadata, without a Chilpa profile."""
import argparse
import os
from pathlib import Path
import sys
import json
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--size", default="1180x760")
parser.add_argument("--screenshot", type=Path)
parser.add_argument("--case", action="store_true", help="Open the first synthetic jewel case.")
parser.add_argument("--theme", choices=["host", "dark", "light", "wood"], default="host")
parser.add_argument("--host-dark", action="store_true")
parser.add_argument("--ambient", action="store_true")
parser.add_argument("--solid", action="store_true")
parser.add_argument("--back", action="store_true")
parser.add_argument("--record", type=Path, help="Record opening, turning and flicking to an MP4 fixture.")
parser.add_argument("--connections", action="store_true")
parser.add_argument("--fullscreen", action="store_true")
parser.add_argument("--wall", action="store_true", help="Preview the wall layout without changing window visibility.")
options = parser.parse_args()
if options.screenshot or options.record:
    os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
    os.environ.setdefault("QT_QUICK_BACKEND", "software")
from PySide6.QtCore import QMetaObject, QTimer, QUrl
from PySide6.QtGui import QGuiApplication
from PySide6.QtQml import QQmlApplicationEngine, QQmlComponent

application = QGuiApplication(sys.argv[:1])
engine = QQmlApplicationEngine()
engine.load(QUrl.fromLocalFile(str(Path(__file__).resolve().parents[1] / "qml/Preview.qml")))
if not engine.rootObjects():
    raise SystemExit("The preview could not load.")
window = engine.rootObjects()[0]
width, height = (int(part) for part in options.size.split("x"))
window.setWidth(width)
window.setHeight(height)
helper_component = QQmlComponent(engine)
helper_component.setData(b'''import QtQuick
QtObject {
 id: helper
 property var target
 property string destination
 property string folder
 property string theme
 property bool hostDark
 property bool ambient
 property bool solid
 property bool back
 property bool openCase
 property bool connections
 property bool fullscreen
 property bool wall
 property bool capturing: false
 property int frame: 0
 property var stamps: []
 property string result: ""
 property var surface: target ? target.contentItem.children[0].surface : null
 property var clock: Timer { interval: 40; repeat: true; onTriggered: helper.grabFrame() }
 function configure() { const stage = target.contentItem.children[0]; surface.themeMode = theme; surface.backend.hostDark = hostDark; surface.backend.hostAmbient = ambient; surface.imagesEnabled = !solid; if (openCase || back) surface.controller.open(surface.backend.album(0)); surface.connectionsOpen = connections; if (fullscreen) stage.setFullscreen(true); else if (wall) surface.fullscreenActive = true }
 function showBack() { if (surface.openCase) surface.openCase.flipTo(true) }
 function open() { surface.controller.open(surface.backend.album(0)) }
 function front() { if (surface.openCase) surface.openCase.flipTo(false) }
 function close() { surface.controller.close() }
 function flick() { surface.shelf.view.flick(-3000, 0) }
 function startMovie() { clock.start() }
 function stopMovie() { clock.stop(); surface.shelf.view.cancelFlick(); result = JSON.stringify(stamps) }
 function grabFrame() {
  if (capturing) return
  capturing = true
  const name = folder + "/" + String(frame++).padStart(4, "0") + ".png", stamp = Date.now()
  surface.grabToImage(function(image) { if (image.saveToFile(name)) stamps.push({file:name,time:stamp}); capturing = false })
 }
 function capture() { surface.grabToImage(function(result) { Qt.exit(result.saveToFile(destination) ? 0 : 1) }) }
}''', QUrl())
helper = helper_component.create()
if not helper:
    raise SystemExit(str(helper_component.errors()))
helper.setProperty("target", window)
for key, value in {"theme":options.theme, "hostDark":options.host_dark, "ambient":options.ambient, "solid":options.solid, "back":options.back, "openCase":options.case and not options.record, "connections":options.connections, "fullscreen":options.fullscreen, "wall":options.wall}.items():
    helper.setProperty(key, value)
def call(name):
    QMetaObject.invokeMethod(helper, name)
QTimer.singleShot(100, lambda:call("configure"))
if options.back:
    QTimer.singleShot(750, lambda:call("showBack"))
if options.screenshot:
    def capture():
        options.screenshot.parent.mkdir(parents=True, exist_ok=True)
        helper.setProperty("destination", str(options.screenshot.resolve()))
        call("capture")
    QTimer.singleShot(1500 if options.back else 1100, capture)
    QTimer.singleShot(7000, lambda: application.exit(2))
if options.record:
    frames = tempfile.TemporaryDirectory(prefix="nest-motion-")
    helper.setProperty("folder", frames.name)
    def movie():
        call("startMovie")
        for delay, action in [(400,"open"),(1600,"showBack"),(2900,"front"),(4000,"close"),(4800,"flick"),(6600,"stopMovie")]:
            QTimer.singleShot(delay, lambda name=action:call(name))
        QTimer.singleShot(7000, lambda:application.exit(0))
    QTimer.singleShot(1200, movie)
    QTimer.singleShot(18000, lambda:application.exit(2))
status = application.exec()
if options.record and status == 0:
    # Concat durations preserve the capture's actual cadence, including readback.
    stamps = json.loads(helper.property("result"))
    listing = Path(frames.name) / "frames.txt"
    lines = []
    for index, entry in enumerate(stamps):
        lines.extend(["file '" + entry["file"] + "'", "duration " + str((stamps[index + 1]["time"] - entry["time"]) / 1000 if index + 1 < len(stamps) else .04)])
    listing.write_text("\n".join(lines) + "\n")
    options.record.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(["ffmpeg","-v","error","-y","-f","concat","-safe","0","-i",str(listing),"-vf","pad=ceil(iw/2)*2:ceil(ih/2)*2","-fps_mode","vfr","-c:v","libx264","-crf","20","-pix_fmt","yuv420p","-movflags","+faststart",str(options.record)],check=True)
    frames.cleanup()
raise SystemExit(status)
